{
  "name": "tanpopo-console",
  "version": "0.3.0",
  "private": true,
  "description": "Tanpopo Web Console SPA (Astryx Neutral + v2 IA)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "generate:api": "node scripts/generate-api-policy.mjs && openapi-typescript ../../openapi/admin-v1.yaml -o src/api/generated.ts",
    "build": "node scripts/check-i18n.mjs --web-only && npm run generate:api && vite build && node scripts/compress-dist.mjs && node scripts/check-bundle-size.mjs",
    "sync:embed": "node scripts/sync-embedded-dist.mjs",
    "test:e2e": "python3 e2e/console_e2e.py"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "lucide-react": "^0.544.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@fontsource/figtree": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
