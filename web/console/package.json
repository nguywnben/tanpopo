{
  "name": "tanpopo-console",
  "version": "0.1.0",
  "private": true,
  "description": "Tanpopo Web Console SPA (Astryx Design System v0.7.16)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "doctor": "astryx doctor",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run generate:api && vite build",
    "generate:api": "openapi-typescript ../../openapi/admin-v1.yaml -o src/api/generated.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@fontsource/figtree": "5.3.0",
    "@stylexjs/rollup-plugin": "0.19.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
